import java.util.Scanner;

public class BinarySudokuUserInput {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[][] board = new int[3][3];

        System.out.println("Enter 3x3 matrix (only 0 and 1):");

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                board[i][j] = sc.nextInt();

                if (board[i][j] != 0 && board[i][j] != 1) {
                    System.out.println("Invalid input! Only 0 or 1 allowed.");
                    return;
                }
            }
        }

        for (int i = 0; i < 3; i++) {
            int count = 0;
            for (int j = 0; j < 3; j++) {
                if (board[i][j] == 1) {
                    count++;
                }
            }
            if (count > 1) {
                System.out.println("Invalid: More than one 1 in row " + (i + 1));
                return;
            }
        }

        // Check columns (at most one 1)
        for (int j = 0; j < 3; j++) {
            int count = 0;
            for (int i = 0; i < 3; i++) {
                if (board[i][j] == 1) {
                    count++;
                }
            }
            if (count > 1) {
                System.out.println("Invalid: More than one 1 in column " + (j + 1));
                return;
            }
        }
        System.out.println("\nMatrix is:");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print(board[i][j] + " ");
            }
            System.out.println();
        }

        System.out.println("\nValid 0/1 Sudoku pattern ✔");

        sc.close();
    }
}
