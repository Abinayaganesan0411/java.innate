import java.util.Scanner;

public class CheckConcatenation {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter size of array: ");
        int n = sc.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            System.out.print("Enter element " + (i + 1) + ": ");
            arr[i] = sc.nextInt();
        }
        System.out.print("Enter number to check: ");
        String checkNumber = sc.next();
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i++) {
            sb.append(arr[i]);
        }
        String concatenated = sb.toString();
        if (concatenated.equals(checkNumber)) {
            System.out.println("The number is concatenated from the array elements.");
        } else {
            System.out.println("The number is NOT concatenated from the array elements.");
        }
        sc.close();
    }
}
